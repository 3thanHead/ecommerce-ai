# Copy to .env (gitignored). No LAN IPs or keys in git.

# --- LLM (edge-ai / Ollama) ----------------------------------------------
# The agent talks to one Ollama endpoint. That's the whole AI connection --
# point it at the edge-ai box (or a local Ollama) and pick a model. Any model
# you've pulled on that box is selectable per request; this is just the default.
#   cluster:  OLLAMA_BASE_URL=http://192.168.1.111:11434
#   local:    OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://192.168.1.111:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Optional "heavy" node for the knowledge-heavy step (category + subreddit
# brainstorm): a bigger model on a beefier box. Blank -> that step uses the
# workhorse above. Example: a 12GB Mac running qwen2.5:14b.
#   OLLAMA_HEAVY_BASE_URL=http://192.168.1.99:11434
#   OLLAMA_HEAVY_MODEL=qwen2.5:14b-instruct
OLLAMA_HEAVY_BASE_URL=
OLLAMA_HEAVY_MODEL=

# --- Datastore ------------------------------------------------------------
# SQLite file. Default lives in the mounted ./data volume.
DATABASE_URL=sqlite:///data/storefront.db

# --- Reddit research ------------------------------------------------------
# Nothing to configure: grounding uses the free Pushshift-successor archives
# (PullPush + Arctic Shift) directly — no keys, no page reader.

# --- Supply counts for MEASURED saturation (all optional) ----------------
# Without any of these, saturation is the model's estimate. Add one and drills
# show a measured supply-based score instead. All free, no card.
# CJdropshipping: # of dropship products per keyword (best signal) + Feature 2
# product source. Free account at https://cjdropshipping.com (API key in
# My CJ > Authorization / API).
CJ_EMAIL=
CJ_API_KEY=

# --- Product image generation (optional) ----------------------------------
# Points at the edge-ai fleet's image-role node (apps/image-gen). Blank ->
# the "Generate image" button on a resolved product just doesn't work (501).
#   cluster:  IMAGE_BASE_URL=http://192.168.1.222:8188
IMAGE_BASE_URL=
IMAGE_MODEL=
