# Copy to .env (gitignored). No LAN IPs or keys in git.

# --- LLM (edge-ai / Ollama) ----------------------------------------------
# The agent talks to one Ollama endpoint. That's the whole AI connection --
# point it at the edge-ai box (or a local Ollama) and pick a model. Any model
# you've pulled on that box is selectable per request; this is just the default.
#   cluster:  OLLAMA_BASE_URL=http://192.168.1.111:11434
#   local:    OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://192.168.1.111:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Datastore ------------------------------------------------------------
# SQLite file. Default lives in the mounted ./data volume.
DATABASE_URL=sqlite:///data/storefront.db

# --- Reddit research ------------------------------------------------------
# Optional. With a script-app client id/secret the RedditClient uses PRAW
# (read-only, ~100 req/min, structured signals). Without them it falls back to
# Reddit's public .json endpoints -- no key, rate-limited, run from a home IP.
# Register a "script" app at https://www.reddit.com/prefs/apps (instant, no
# approval queue -- that's only the commercial Data API).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive UA on every request; used by both paths.
REDDIT_USER_AGENT=storefront-ai/0.1 (niche research; +https://github.com/3thanHead)

# --- Page reader (Reddit grounding) --------------------------------------
# How the agent reads Reddit. Reddit IP-blocks this box (and the keyless Jina
# reader), so grounded drills need a reader that fetches server-side with
# rotating IPs. Firecrawl does this; free tier is 1,000 credits/month (1 credit
# per page, ~5 pages per drill => ~200 drills/mo), NO credit card. Sign up at
# https://firecrawl.dev (GitHub login) and paste the key here.
FIRECRAWL_API_KEY=
# Keyless fallback used only when FIRECRAWL_API_KEY is blank (unreliable on
# Reddit right now, but free).
JINA_READER_BASE=https://r.jina.ai

# --- CJdropshipping (Feature 2, not wired yet) ---------------------------
# CJ_EMAIL=
# CJ_API_KEY=
