# Copy to .env (gitignored). No LAN IPs or keys in git.

# The LLM endpoint — all generation goes here, free. Point it at the home
# cluster's HAProxy master, or at this machine's own Ollama for local/dev
# (in docker use host.docker.internal, not localhost — see docker-compose.yml).
LLM_BASE_URL=http://192.168.1.111:11434
# Local, no cluster:  LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b-instruct

# The fleet's image node (ComfyUI/SD API on the RTX box), once it's up.
IMAGE_BASE_URL=http://192.168.1.222:8188

# Public site base — the CloudFront URL from `terraform output site_url`
# (or the custom domain later). Links the agent mints use this.
BLOG_BASE_URL=

# Payments / print-on-demand (optional until those steps go live).
STRIPE_API_KEY=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
